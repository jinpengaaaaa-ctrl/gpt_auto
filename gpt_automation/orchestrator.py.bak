_SENSITIVE_DIGITS = re.compile(r"\d{12,}")


def _redact_text(value: str) -> str:
    """Mask long numeric secrets (card numbers etc.) in operator-facing text."""
    return _SENSITIVE_DIGITS.sub("[REDACTED]", value)

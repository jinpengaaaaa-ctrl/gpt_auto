# ==========================================
# ChatGPT Auto-Registration — 环境变量配置模板
# ==========================================
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
#
# 注意：Outlook 邮箱验证用的是 email.txt 中每行自带的
# client_id + refresh_token（微软 OAuth2 标准流程），
# 不需要额外设置 OUTLOOK_API_KEY。


# ==========================================
# 邮箱验证码 3 轮取码 + 再送信
# ==========================================
# 第 1 轮等待首封邮件（默认 60 秒）
EMAIL_CODE_ROUND1_TIMEOUT_S=60
# 第 2 轮：点击「メールを再送信する」后再等（默认 45 秒）
EMAIL_CODE_ROUND2_TIMEOUT_S=45
# 第 3 轮：再次点击再送信后再等（默认 45 秒）
EMAIL_CODE_ROUND3_TIMEOUT_S=45
# 再送信次数上限（0 关闭再送信；默认 2；取码轮次 = max_resend + 1）
EMAIL_CODE_MAX_RESEND=2
# 轮询间隔秒数（默认 3）
EMAIL_CODE_POLL_INTERVAL_S=3
# 是否启用再送信（true/false，默认 true）
EMAIL_CODE_ENABLE_RESEND=true


# ==========================================
# ????????????
# ==========================================
# ????????????????? 8?????????????
PASSWORD_CONTINUATION_PROBE_S=8

# ==========================================
# iKuai 路由器 API（Feature #11A — IP 轮换）
# ==========================================
# 局域网中 iKuai 路由器的管理地址（默认 192.168.1.1）
IKUAI_API_URL=http://192.168.1.1

# 路由器管理员账号
IKUAI_USERNAME=admin

# 路由器管理员密码
IKUAI_PASSWORD=

# 单 ADSL 启停目标（每台机器不同）
# 只需填名字，VLAN ID 自动从 ADSL_MAP 解析
IKUAI_TARGET_WAN_NAME=adsl3    # adsl3 → id=5, adsl4 → id=6, adsl5 → id=7 ...
IKUAI_REDIAL_DELAY=5.0


# ==========================================
# Xray 直控配置（替代 v2rayN HTTP API）
# ==========================================
# Xray 安装根目录：xray.exe 和 JSON 配置文件都在此目录下
# 例：D:\tool\v2rayN-windows-64
XRAY_BASE_DIR=.

# Xray 启动后等待就绪的秒数（默认 3.0）
XRAY_STARTUP_DELAY=3.0


# ==========================================
# IP 检测配置（独立 HTTP 检测，不依赖浏览器）
# ==========================================
# IP 检测 HTTP 请求超时秒数（自动路由模式，默认 8.0）
IP_CHECK_TIMEOUT=8.0

# IP 检测最大重试次数（自动路由模式，默认 3）
IP_CHECK_MAX_RETRIES=3


# ==========================================
# Windows 系统代理配置
# ==========================================
# 代理监听地址（默认 127.0.0.1）
PROXY_HOST=127.0.0.1

# 代理监听端口（默认 10808，须与 Xray 配置中 inbounds 端口一致）
PROXY_PORT=10808


# ==========================================
# 代理配置（可选 — 动态住宅代理/SOCKS5）
# ==========================================
# 是否启用代理（true/false）
# ⚠️ 当 IP_ROTATION_MODE=manual-hotspot 时，此项会被自动覆写为 false（无需手动修改）
PROXY_ENABLED=false

# 代理服务器地址（支持 socks5:// 或 http://）
PROXY_SERVER=socks5://127.0.0.1:1080

# 代理用户名（可选）
PROXY_USERNAME=

# 代理密码（可选）
PROXY_PASSWORD=

# 动态代理刷新 IP 的 API 链接（可选）
PROXY_DYNAMIC_API_URL=


# ==========================================
# 开发模式
# ==========================================
# 设为 true 使用本地 HTML fixture 测试，不上真实 ChatGPT
DEV_MODE=false


# ==========================================
# IP 轮换模式
# ==========================================
# 可选: v2rayn+ikuai | ikuai | ikuai-single | manual | auto
IP_ROTATION_MODE=ikuai-single

# 严格模式：true 时 IP 检测全部失败则终止批量流程（默认 true）
IP_STRICT_MODE=true

# 手动 IP 自动轮询检测间隔秒数（默认 10，无需人工按键）
MANUAL_IP_POLL_INTERVAL_S=10.0
# 手动 IP 无变化确认窗口秒数（默认 540 = 9 分钟，窗口到期后向操作员确认）
MANUAL_IP_POLL_WINDOW_S=540.0
# 手动 IP 单次检测 HTTP 超时秒数（默认 8.0）
# 断网时程序不设重试次数上限：按 MANUAL_IP_POLL_INTERVAL_S 持续自动检测，
# 网络恢复后自动继续；辅助模式仅等待窗口到期后才会向操作员确认。
MANUAL_IP_CHECK_TIMEOUT_S=8.0

# ==========================================
# ChatGPT 账户密码
# ==========================================
# 每个新 session 生成的 ChatGPT 密码长度（默认 18，仅大小写字母与数字，最小 12）
CHATGPT_PASSWORD_LENGTH=18

# ==========================================
# 批量执行控制
# ==========================================
# 单次批量最大注册数（0 = 无限制，直到资源耗尽）
MAX_ACCOUNTS=0

# 全自动模式：设为 true 时，失败步骤自动跳过（无人值守）；
# 设为 false 时，失败时弹出交互菜单让操作员决定（需人工在场）
AUTO_MODE=true

# start.bat 的恢复区默认隐藏；仅在需要重新显示时设为 true。
# 显式 CLI 恢复命令不受此开关影响。
RECOVERY_SECTION_ENABLED=false

# ChatGPT 帐号密码（可选，仅供旧诊断入口兼容；生产 start.bat 按 session 随机生成）

# CloakBrowser Pro／免费密钥（可选；不填写时使用免费 Chromium 版本）
CLOAKBROWSER_LICENSE_KEY=
